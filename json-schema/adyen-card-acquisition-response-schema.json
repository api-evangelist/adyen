        "AccountNumber",
        "BarCode",
        "ISOTrack2",
        "PAN",
        "PhoneNumber"
      ]
    },
    "LoyaltyAccount": {
      "type": "object",
      "description": "This data structure conveys the identification of the account and the associated loyalty brand. Data related to a loyalty account processed in the transaction.",
      "properties": {
