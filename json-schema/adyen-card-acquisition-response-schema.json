          "$ref": "#/$defs/SensitiveMobileData"
        }
      }
    },
    "POIData": {
      "type": "object",
      "description": "In the Message Response, identification of the POI transaction. Data related to the POI System.",
      "properties": {
        "POITransactionID": {
          "$ref": "#/$defs/TransactionIDType"
        },
        "POIReconciliationID": {
