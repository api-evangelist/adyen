    "MobileData": {
      "type": "object",
      "description": "Mobile phone is used as a payment instrument for the transaction. Information related to the mobile for the payment transaction.",
      "properties": {
        "MobileCountryCode": {
          "type": "integer",
          "minimum": 3,
          "maximum": 3,
          "description": "If data available."
        },
        "MobileNetworkCode": {
          "type": "integer",
          "minimum": 2,
          "maximum": 3,
          "description": "If data available."
        },
        "MaskedMSISDN": {
          "type": "integer",
          "description": "If data available."
        },
        "Geolocation": {
          "$ref": "#/$defs/Geolocation"
        },
        "ProtectedMobileData": {
          "type": "string",
          "description": "SensitiveMobileData."
        },
