          "request": {
            "name": "Adyen Transfer Funds Between Platform Accounts",
            "description": {
              "content": "Transfers funds from one account to another account. Both accounts must be in the same platform, but can have different account holders. The transfer must include a transfer code, which should be determined by the platform, in compliance with local regulations.",
