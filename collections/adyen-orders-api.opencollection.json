{
  "opencollection": "1.0.0",
  "info": {
    "name": "Adyen Account acceptDispute Orders API",
    "version": "6"
  },
  "items": [
    {
      "info": {
        "name": "Orders",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Adyen Create an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cal-test.adyen.com/cal/services/Account/v6/orders",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": "37ca9c97-d1d1-4c62-89e8-706891a563ed"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Creates an order to be used for partial payments. Make a POST `/orders` call before making a `/payments` call when processing payments with different payment methods."
        },
        {
          "info": {
            "name": "Adyen Cancel an Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://cal-test.adyen.com/cal/services/Account/v6/orders/cancel",
            "headers": [
              {
                "name": "Idempotency-Key",
                "value": "37ca9c97-d1d1-4c62-89e8-706891a563ed"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Cancels an order. Cancellation of an order results in an automatic rollback of all payments made in the order, either by canceling or refunding the payment, depending on the type of payment method."
        }
      ]
    }
  ],
  "bundled": true
}