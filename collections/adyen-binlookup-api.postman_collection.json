              "raw": "{\n  \"merchantAccount\": \"<string>\",\n  \"additionalData\": {\n    \"key_0\": \"<string>\"\n  },\n  \"brands\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"cardNumber\": \"<string>\",\n  \"recurringDetailReference\": \"<string>\",\n  \"shopperReference\": \"<string>\"\n}",
