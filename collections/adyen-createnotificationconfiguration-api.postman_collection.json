                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"configurationDetails\": {\n    \"active\": \"<boolean>\",\n    \"apiVersion\": \"<integer>\",\n    \"description\": \"<string>\",\n    \"eventConfigs\": [\n      {\n        \"eventType\": \"<string>\",\n        \"includeMode\": \"<string>\"\n      },\n      {\n        \"eventType\": \"<string>\",\n        \"includeMode\": \"<string>\"\n      }\n    ],\n    \"hmacSignatureKey\": \"<string>\",\n    \"notificationId\": \"<long>\",\n    \"notifyPassword\": \"<string>\",\n    \"notifyURL\": \"<string>\",\n    \"notifyUsername\": \"<string>\",\n    \"sslProtocol\": \"<string>\"\n  }\n}",
