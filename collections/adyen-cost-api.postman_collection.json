          "id": "7df1d8a8-fcd8-4fcf-8969-9fffe1801e2e",
          "name": "Adyen Get a Fees Cost Estimate",
          "request": {
            "name": "Adyen Get a Fees Cost Estimate",
            "description": {
              "content": ">This API is available only for merchants operating in Australia, the EU, and the UK.\n\nUse the Adyen Cost Estimation API to pre-calculate interchange and scheme fee costs. Knowing these costs prior actual payment authorisation gives you an opportunity to charge those costs to the cardholder, if necessary.\n\nTo retrieve this information, make the call to the `/getCostEstimate` endpoint. The response to this call contains the amount of the interchange and scheme fees charged by the network for this transaction, and also which surcharging policy is possible (based on current regulations).\n\n> Since not all information is known in advance (for example, if the cardholder will successfully authenticate via 3D Secure or if you also plan to provide additional Level 2/3 data), the returned amounts are based on a set of assumption criteria you define in the `assumptions` parameter.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "getCostEstimate"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"value\": \"<long>\",\n    \"currency\": \"<string>\"\n  },\n  \"merchantAccount\": \"<string>\",\n  \"assumptions\": {\n    \"assume3DSecureAuthenticated\": \"<boolean>\",\n    \"assumeLevel3Data\": \"<boolean>\",\n    \"installments\": \"<integer>\"\n  },\n  \"cardNumber\": \"<string>\",\n  \"encryptedCardNumber\": \"<string>\",\n  \"merchantDetails\": {\n    \"countryCode\": \"<string>\",\n    \"enrolledIn3DSecure\": \"<boolean>\",\n    \"mcc\": \"<string>\"\n  },\n  \"recurring\": {\n    \"contract\": \"<string>\",\n    \"recurringDetailName\": \"<string>\",\n    \"recurringExpiry\": \"<dateTime>\",\n    \"recurringFrequency\": \"<string>\",\n    \"tokenService\": \"<string>\"\n  },\n  \"selectedRecurringDetailReference\": \"<string>\",\n  \"shopperInteraction\": \"<string>\",\n  \"shopperReference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
