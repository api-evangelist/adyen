          "name": "Adyen Designate a Beneficiary Account and Transfer the Benefactor's Current Balance",
          "request": {
            "name": "Adyen Designate a Beneficiary Account and Transfer the Benefactor's Current Balance",
            "description": {
              "content": "Defines a benefactor and a beneficiary relationship between two accounts. At the time of benefactor/beneficiary setup, the funds in the benefactor account are transferred to the beneficiary account, and any further payments to the benefactor account are automatically sent to the beneficiary account. A series of benefactor/beneficiaries may not exceed four beneficiaries and may not have a cycle in it.",
              "type": "text/plain"
            },
