            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantAccount\": \"<string>\",\n  \"reference\": \"<string>\",\n  \"amount\": {\n    \"value\": \"<long>\",\n    \"currency\": \"<string>\"\n  },\n  \"shopperEmail\": \"<string>\",\n  \"shopperReference\": \"<string>\",\n  \"recurring\": {\n    \"contract\": \"<string>\",\n    \"recurringDetailName\": \"<string>\",\n    \"recurringExpiry\": \"<dateTime>\",\n    \"recurringFrequency\": \"<string>\",\n    \"tokenService\": \"<string>\"\n  },\n  \"selectedRecurringDetailReference\": \"<string>\",\n  \"additionalData\": {\n    \"key_0\": \"<string>\",\n    \"key_1\": \"<string>\",\n    \"key_2\": \"<string>\"\n  },\n  \"dateOfBirth\": \"<date>\",\n  \"entityType\": \"<string>\",\n  \"fraudOffset\": \"<integer>\",\n  \"nationality\": \"<string>\",\n  \"shopperName\": {\n    \"firstName\": \"<string>\",\n    \"lastName\": \"<string>\"\n  },\n  \"shopperStatement\": \"<string>\",\n  \"socialSecurityNumber\": \"<string>\"\n}",
              "options": {
