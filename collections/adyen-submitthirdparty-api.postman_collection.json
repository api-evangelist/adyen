            "name": "Adyen Submit a Payout",
            "description": {
              "content": "Submits a payout using the previously stored payment details. To store payment details, use the `/storeDetail` API call.\n\nThe submitted payout must be confirmed or declined either by a reviewer or via `/confirmThirdParty` or `/declineThirdParty` calls.",
              "type": "text/plain"
            },
