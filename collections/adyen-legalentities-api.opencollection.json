            "method": "GET",
            "url": "https://cal-test.adyen.com/cal/services/Account/v6/legalEntities/:id/pciQuestionnaires",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The unique identifier of the legal entity to get PCI questionnaire information."
              }
            ],
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Get a list of signed PCI questionnaires."
        },
        {
          "info": {
            "name": "Adyen Generate PCI Questionnaire",
            "type": "http"
