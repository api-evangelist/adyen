          "id": "266476ca-6e89-4fe7-9b71-5bc1cff31887",
          "name": "Adyen Get Tokens for Stored Payment Details",
          "request": {
            "name": "Adyen Get Tokens for Stored Payment Details",
            "description": {
              "content": "Lists the tokens for stored payment details for the shopper identified in the path, if there are any available. The token ID can be used with payment requests for the shopper's payment. A summary of the stored details is included.\n\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "storedPaymentMethods"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "shopperReference",
                  "value": "<string>",
                  "description": "Your reference to uniquely identify this shopper, for example user ID or account ID. Minimum length: 3 characters.\n> Your reference must not include personally identifiable information (PII), for example name or email address."
                },
                {
                  "disabled": false,
                  "key": "merchantAccount",
                  "value": "<string>",
                  "description": "Your merchant account."
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}"
                }
              ]
            }
          },
