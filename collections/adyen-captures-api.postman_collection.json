                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "paymentPspReference",
                  "description": "(Required) The [`pspReference`](https://docs.adyen.com/api-explorer/#/CheckoutService/latest/post/payments__resParam_pspReference) of the payment that you want to capture."
                }
              ]
            },
            "header": [
              {
                "disabled": false,
