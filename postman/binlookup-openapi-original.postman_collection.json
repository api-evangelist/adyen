    {
      "name": "getCostEstimate",
      "item": [
        {
          "name": "Adyen Get a Fees Cost Estimate",
          "id": "589382a4-5d08-404e-b155-7b9b3048c229",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"amount\": {\n    \"value\": \"<long>\",\n    \"currency\": \"<string>\"\n  },\n  \"merchantAccount\": \"<string>\",\n  \"assumptions\": {\n    \"assume3DSecureAuthenticated\": \"<boolean>\",\n    \"assumeLevel3Data\": \"<boolean>\",\n    \"installments\": \"<integer>\"\n  },\n  \"cardNumber\": \"<string>\",\n  \"encryptedCardNumber\": \"<string>\",\n  \"merchantDetails\": {\n    \"countryCode\": \"<string>\",\n    \"enrolledIn3DSecure\": \"<boolean>\",\n    \"mcc\": \"<string>\"\n  },\n  \"recurring\": {\n    \"contract\": \"RECURRING\",\n    \"recurringDetailName\": \"<string>\",\n    \"recurringExpiry\": \"<dateTime>\",\n    \"recurringFrequency\": \"<string>\",\n    \"tokenService\": \"VISATOKENSERVICE\"\n  },\n  \"selectedRecurringDetailReference\": \"<string>\",\n  \"shopperInteraction\": \"ContAuth\",\n  \"shopperReference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/getCostEstimate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "getCostEstimate"
              ]
            },
            "description": ">This API is available only for merchants operating in Australia, the EU, and the UK.\n\nUse the Adyen Cost Estimation API to pre-calculate interchange and scheme fee costs. Knowing these costs prior actual payment authorisation gives you an opportunity to charge those costs to the cardholder, if necessary.\n\nTo retrieve this information, make the call to the `/getCostEstimate` endpoint. The response to this call contains the amount of the interchange and scheme fees charged by the network for this transaction, and also which surcharging policy is possible (based on current regulations).\n\n> Since not all information is known in advance (for example, if the cardholder will successfully authenticate via 3D Secure or if you also plan to provide additional Level 2/3 data), the returned amounts are based on a set of assumption criteria you define in the `assumptions` parameter."
          },
          "response": [
            {
              "id": "a26ad4b5-e9ac-4609-b503-e3cfc690efd0",
              "name": "OK - the request has succeeded.",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  },
                  {
                    "description": "Added as a part of security scheme: basic",
                    "key": "Authorization",
                    "value": "Basic <credentials>"
                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"amount\": {\n    \"value\": \"<long>\",\n    \"currency\": \"<string>\"\n  },\n  \"merchantAccount\": \"<string>\",\n  \"assumptions\": {\n    \"assume3DSecureAuthenticated\": \"<boolean>\",\n    \"assumeLevel3Data\": \"<boolean>\",\n    \"installments\": \"<integer>\"\n  },\n  \"cardNumber\": \"<string>\",\n  \"encryptedCardNumber\": \"<string>\",\n  \"merchantDetails\": {\n    \"countryCode\": \"<string>\",\n    \"enrolledIn3DSecure\": \"<boolean>\",\n    \"mcc\": \"<string>\"\n  },\n  \"recurring\": {\n    \"contract\": \"RECURRING\",\n    \"recurringDetailName\": \"<string>\",\n    \"recurringExpiry\": \"<dateTime>\",\n    \"recurringFrequency\": \"<string>\",\n    \"tokenService\": \"VISATOKENSERVICE\"\n  },\n  \"selectedRecurringDetailReference\": \"<string>\",\n  \"shopperInteraction\": \"ContAuth\",\n  \"shopperReference\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/getCostEstimate",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "getCostEstimate"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "cookie": [],
              "responseTime": null,
              "body": "{\n  \"cardBin\": {\n    \"bin\": \"<string>\",\n    \"commercial\": \"<boolean>\",\n    \"fundingSource\": \"<string>\",\n    \"fundsAvailability\": \"<string>\",\n    \"issuerBin\": \"<string>\",\n    \"issuingBank\": \"<string>\",\n    \"issuingCountry\": \"<string>\",\n    \"issuingCurrency\": \"<string>\",\n    \"paymentMethod\": \"<string>\",\n    \"payoutEligible\": \"<string>\",\n    \"summary\": \"<string>\"\n  },\n  \"costEstimateAmount\": {\n    \"value\": \"<long>\",\n    \"currency\": \"<string>\"\n  },\n  \"costEstimateReference\": \"<string>\",\n  \"resultCode\": \"<string>\",\n  \"surchargeType\": \"<string>\"\n}",
              "createdAt": "2026-06-05T13:12:05.000Z",
              "updatedAt": "2026-06-05T13:12:05.000Z",
              "uid": "35240-a26ad4b5-e9ac-4609-b503-e3cfc690efd0"
