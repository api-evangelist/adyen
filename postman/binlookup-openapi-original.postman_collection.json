    {
      "name": "get3dsAvailability",
      "item": [
        {
          "name": "Adyen Check if 3D Secure is Available",
          "id": "155c8762-924c-4013-94ce-11808f502277",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                {
                  "key": "username",
                  "value": "{{basicAuthUsername}}",
                  "type": "string"
                },
                {
                  "key": "password",
                  "value": "{{basicAuthPassword}}",
                  "type": "string"
                }
              ]
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"merchantAccount\": \"<string>\",\n  \"additionalData\": {\n    \"id_a5f\": \"<string>\",\n    \"aliquip_6\": \"<string>\"\n  },\n  \"brands\": [\n    \"<string>\",\n    \"<string>\"\n  ],\n  \"cardNumber\": \"<string>\",\n  \"recurringDetailReference\": \"<string>\",\n  \"shopperReference\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "headerFamily": "json",
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/get3dsAvailability",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "get3dsAvailability"
              ]
            },
            "description": "Verifies whether 3D Secure is available for the specified BIN or card brand. For 3D Secure 2, this endpoint also returns device fingerprinting keys.\n\nFor more information, refer to [3D Secure 2](https://docs.adyen.com/online-payments/3d-secure/native-3ds2)."
          },
